*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
# Preserve recovered source bytes so recovered-source.json remains verifiable.
compression/recovered/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
compression/baseline/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
compression/blk2.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
